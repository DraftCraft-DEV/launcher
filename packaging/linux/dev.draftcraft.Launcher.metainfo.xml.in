<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>dev.draftcraft.Launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>D.E.V. Launcher</name>
  <summary>Install, update and launch the D.E.V. App Suite</summary>
  <developer id="dev.draftcraft">
    <name>DraftCraft Engineering Ventures</name>
  </developer>
  <description>
    <p>
      D.E.V. Launcher lists every app in the D.E.V. App Suite (DraftCraft and TraceDraw), installs the right build for your computer, and keeps them up to date.
    </p>
    <ul>
      <li>One place to find, install and open every D.E.V. app</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.draftcraft.Launcher.desktop</launchable>
  <icon type="stock">dev.draftcraft.Launcher</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://draftcraft.dev</url>
  <url type="bugtracker">https://github.com/DraftCraft-DEV/launcher/issues</url>
  <url type="help">https://github.com/DraftCraft-DEV/launcher</url>
  <url type="contact">https://discord.gg/YgRK8Eww9x</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword>installer</keyword>
    <keyword>updater</keyword>
    <keyword>draftcraft</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#d9dce3</color>
    <color type="primary" scheme_preference="dark">#26282e</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>dev-launcher</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
